# Copy to .env.local for local development, and add the same three
# variables in your hosting provider (Cloudflare Pages → Settings → Variables).
# These are PUBLIC values. Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon or publishable key>
VITE_VAPID_PUBLIC_KEY=<public VAPID key from `npm run vapid`>
